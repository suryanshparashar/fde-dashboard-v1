    "@types/papaparse": "^5.3.15",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "jasmine-core": "~5.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "playwright-core": "^1.49.1",
    "postcss": "^8.4.49",
